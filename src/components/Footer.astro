---

---

<footer class="bg-gray-800 pb-8 pt-16 text-white">
  <div class="mx-auto max-w-7xl px-4">
    <!-- Main Footer Content -->
    <div class="mb-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <!-- Company Info & Logo -->
      <div class="lg:col-span-1">
        <div class="mb-6 flex items-center">
          <img
            src="/assets/images/logo.webp"
            alt="Get Yo Frozen Yogurt Logo"
            class="h-16 w-auto"
            width="200"
            height="100"
          />
        </div>
        <p class="mb-6 leading-relaxed text-gray-300">
          New Jersey's premium frozen yogurt destination. Serving fresh,
          delicious treats with 14 amazing flavors and endless topping
          combinations since 2020.
        </p>

        <!-- Social Media Links -->
        <div class="flex space-x-4">
          <a
            href="https://www.instagram.com/getyo_marlboro/"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon"
            aria-label="Follow us on Instagram"
          >
            <i class="ri-instagram-line"></i>
          </a>
          <a
            href="https://www.tiktok.com/@getyofrozenyogurtcafe"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon"
            aria-label="Follow us on TikTok"
          >
            <i class="ri-tiktok-line"></i>
          </a>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div class="lg:col-span-1">
        <h3 class="mb-6 text-xl font-bold text-white">Quick Links</h3>
        <nav class="space-y-3">
          <a
            href="#home"
            class="block text-gray-300 transition-all duration-200 hover:translate-x-1 hover:text-white"
          >
            <i class="ri-home-line mr-2"></i>Home
          </a>
          <a
            href="#locations"
            class="block text-gray-300 transition-all duration-200 hover:translate-x-1 hover:text-white"
          >
            <i class="ri-map-pin-line mr-2"></i>Our Locations
          </a>
          <a
            href="#menu"
            class="block text-gray-300 transition-all duration-200 hover:translate-x-1 hover:text-white"
          >
            <i class="ri-restaurant-line mr-2"></i>Menu & Flavors
          </a>
          <a
            href="#careers"
            class="block text-gray-300 transition-all duration-200 hover:translate-x-1 hover:text-white"
          >
            <i class="ri-briefcase-line mr-2"></i>Join Our Team
          </a>
          <a
            href="#contact"
            class="block text-gray-300 transition-all duration-200 hover:translate-x-1 hover:text-white"
          >
            <i class="ri-mail-line mr-2"></i>Contact Us
          </a>
          <a
            href="https://get-yo-web-app.vercel.app/api/download"
            target="_blank"
            class="block text-gray-300 transition-all duration-200 hover:translate-x-1 hover:text-white"
          >
            <i class="ri-gift-line mr-2"></i>Rewards Program
          </a>
        </nav>
      </div>

      <!-- Store Locations -->
      <div class="lg:col-span-1">
        <h3 class="mb-6 text-xl font-bold text-white">Visit Us</h3>

        <!-- Marlboro Location -->
        <div class="mb-6 rounded-lg bg-gray-700 p-4">
          <div class="mb-3 flex items-start">
            <i class="ri-store-2-fill mr-3 mt-1 text-primary"></i>
            <div>
              <h4 class="mb-1 font-bold text-white">Marlboro Location</h4>
              <p class="text-sm text-gray-300">450 Union Hill Road</p>
              <p class="text-sm text-gray-300">Morganville, NJ 07751</p>
            </div>
          </div>
          <div class="space-y-2">
            <div class="flex items-center text-sm text-gray-300">
              <i class="ri-phone-line mr-2 text-primary"></i>
              <a href="tel:7326176332" class="hover:text-white"
                >(732) 617-6332</a
              >
            </div>
            <div class="flex items-center text-sm text-gray-300">
              <i class="ri-award-line mr-2 text-primary"></i>
              <span>Kosher Certified</span>
            </div>
            <div class="flex items-center text-sm text-gray-300">
              <i class="ri-customer-service-line mr-2 text-primary"></i>
              <span>Call for special orders</span>
            </div>
            <div class="mt-3">
              <a
                href="https://maps.google.com/?q=450+Union+Hill+Road+Morganville+NJ+07751"
                target="_blank"
                class="text-sm font-medium text-primary transition-colors hover:text-primary/80"
              >
                <i class="ri-map-pin-line mr-1"></i>Get Directions
              </a>
            </div>
          </div>
        </div>

        <!-- New Providence Location -->
        <div class="rounded-lg bg-gray-700 p-4">
          <div class="mb-3 flex items-start">
            <i class="ri-store-2-fill mr-3 mt-1 text-secondary"></i>
            <div>
              <h4 class="mb-1 font-bold text-white">New Providence</h4>
              <p class="text-sm text-gray-300">12 South Street</p>
              <p class="text-sm text-gray-300">New Providence, NJ 07974</p>
            </div>
          </div>
          <div class="space-y-2">
            <div class="flex items-center text-sm text-gray-300">
              <i class="ri-phone-line mr-2 text-secondary"></i>
              <a href="tel:9082194338" class="hover:text-white"
                >(908) 219-4338</a
              >
            </div>
            <div class="flex items-center text-sm text-gray-300">
              <i class="ri-customer-service-line mr-2 text-secondary"></i>
              <span>Call for special orders</span>
            </div>
            <div class="mt-3">
              <a
                href="https://maps.google.com/?q=12+South+Street+New+Providence+NJ+07974"
                target="_blank"
                class="text-sm font-medium text-secondary transition-colors hover:text-secondary/80"
              >
                <i class="ri-map-pin-line mr-1"></i>Get Directions
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Newsletter & Contact -->
      <div class="lg:col-span-1">
        <h3 class="mb-6 text-xl font-bold text-white">Stay Connected</h3>
        <p class="mb-6 text-gray-300">
          Get the latest updates on new flavors, special offers, and events!
        </p>

        <!-- Newsletter Signup -->
        <div class="newsletter-form-container mb-6">
          <form class="newsletter-form" id="newsletter-form">
            <div class="space-y-2">
              <input
                type="email"
                placeholder="Your email address"
                required
                class="w-full rounded-lg border border-gray-600 bg-gray-700 px-4 py-3 text-white placeholder-gray-400 transition-all focus:border-primary focus:ring-2 focus:ring-primary focus:ring-opacity-50"
              />
              <button
                type="submit"
                class="flex w-full items-center justify-center rounded-lg bg-primary px-6 py-3 font-medium text-white transition-colors hover:bg-primary/90"
                aria-label="Subscribe to newsletter"
              >
                <i class="ri-send-plane-line mr-2"></i>Subscribe
              </button>
            </div>
          </form>
          <p class="mt-2 text-xs text-gray-400">
            We respect your privacy. Unsubscribe anytime.
          </p>
        </div>

        <!-- Special Offers Badge -->
        <div
          class="rounded-lg bg-gradient-to-r from-primary to-secondary p-4 text-center"
        >
          <i class="ri-gift-2-line mb-2 text-2xl"></i>
          <p class="text-sm font-bold">Join Ounce&Bounce</p>
          <p class="text-xs opacity-90">Get 100 bonus points today!</p>
        </div>
      </div>
    </div>

    <!-- Modern Store Hours Section -->
    <div class="mb-8 border-t border-gray-700 pt-12">
      <div class="mb-8 text-center">
        <h3 class="mb-2 text-2xl font-bold text-white">Store Hours</h3>
        <p class="text-gray-400">
          Visit us during these convenient hours (Eastern Time)
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <!-- Marlboro Hours Card -->
        <div
          class="rounded-2xl border border-gray-600 bg-gradient-to-br from-gray-700 to-gray-800 p-6 shadow-lg transition-all duration-300 hover:scale-105 hover:transform hover:border-primary/50"
        >
          <!-- Location Header -->
          <div class="mb-6 flex items-center">
            <div
              class="mr-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/20"
            >
              <i class="ri-store-2-fill text-xl text-primary"></i>
            </div>
            <div>
              <h4 class="mb-0 text-xl font-bold text-white">Marlboro</h4>
              <p class="text-sm text-gray-400">Morganville, NJ</p>
            </div>
          </div>

          <!-- Dynamic Hours Grid -->
          <div id="marlboro-footer-hours">
            <!-- Loading state -->
            <div class="py-6 text-center">
              <div
                class="mx-auto mb-3 h-6 w-6 animate-spin rounded-full border-2 border-primary border-t-transparent"
              >
              </div>
              <p class="text-sm text-gray-400">Loading hours...</p>
            </div>
          </div>

          <!-- Status and Contact -->
          <div class="mt-6 space-y-3">
            <div class="flex items-center justify-between">
              <div
                id="marlboro-status"
                class="rounded-full bg-green-500/20 px-3 py-1 text-sm font-medium text-green-400"
              >
                <i class="ri-time-line mr-1"></i>
                <span id="marlboro-status-text">Loading...</span>
              </div>
              <a
                href="tel:7326176332"
                class="text-sm text-primary transition-colors hover:text-primary/80"
              >
                <i class="ri-phone-line mr-1"></i>
                Call Now
              </a>
            </div>
            <div
              class="flex items-center justify-between border-t border-gray-600 pt-2"
            >
              <span class="text-xs text-gray-400">
                <i class="ri-award-line mr-1"></i>Kosher Certified
              </span>
              <a
                href="https://maps.google.com/?q=450+Union+Hill+Road+Morganville+NJ+07751"
                target="_blank"
                class="text-sm text-primary transition-colors hover:text-primary/80"
              >
                <i class="ri-map-pin-line mr-1"></i>Directions
              </a>
            </div>
          </div>
        </div>

        <!-- New Providence Hours Card -->
        <div
          class="rounded-2xl border border-gray-600 bg-gradient-to-br from-gray-700 to-gray-800 p-6 shadow-lg transition-all duration-300 hover:scale-105 hover:transform hover:border-secondary/50"
        >
          <!-- Location Header -->
          <div class="mb-6 flex items-center">
            <div
              class="mr-4 flex h-12 w-12 items-center justify-center rounded-full bg-secondary/20"
            >
              <i class="ri-store-2-fill text-xl text-secondary"></i>
            </div>
            <div>
              <h4 class="mb-0 text-xl font-bold text-white">New Providence</h4>
              <p class="text-sm text-gray-400">New Providence, NJ</p>
            </div>
          </div>

          <!-- Dynamic Hours Grid -->
          <div id="providence-footer-hours">
            <!-- Loading state -->
            <div class="py-6 text-center">
              <div
                class="mx-auto mb-3 h-6 w-6 animate-spin rounded-full border-2 border-secondary border-t-transparent"
              >
              </div>
              <p class="text-sm text-gray-400">Loading hours...</p>
            </div>
          </div>

          <!-- Status and Contact -->
          <div class="mt-6 space-y-3">
            <div class="flex items-center justify-between">
              <div
                id="providence-status"
                class="rounded-full bg-green-500/20 px-3 py-1 text-sm font-medium text-green-400"
              >
                <i class="ri-time-line mr-1"></i>
                <span id="providence-status-text">Loading...</span>
              </div>
              <a
                href="tel:9082194338"
                class="text-sm text-secondary transition-colors hover:text-secondary/80"
              >
                <i class="ri-phone-line mr-1"></i>
                Call Now
              </a>
            </div>
            <div
              class="flex items-center justify-center border-t border-gray-600 pt-2"
            >
              <a
                href="https://maps.google.com/?q=12+South+Street+New+Providence+NJ+07974"
                target="_blank"
                class="text-sm text-secondary transition-colors hover:text-secondary/80"
              >
                <i class="ri-map-pin-line mr-1"></i>Get Directions
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Info Bar -->
      <div class="mt-8 rounded-xl bg-gray-700/50 p-4">
        <div
          class="flex flex-col items-center justify-between gap-4 sm:flex-row"
        >
          <div class="flex items-center text-gray-300">
            <i class="ri-information-line mr-2 text-primary"></i>
            <span class="text-sm"
              >Hours may vary on holidays. Call for special orders and to
              confirm hours.</span
            >
          </div>
          <div class="flex flex-wrap gap-3">
            <span
              class="rounded-full bg-primary/20 px-3 py-1 text-xs font-medium text-primary"
            >
              <i class="ri-award-line mr-1"></i>Kosher Certified
            </span>
            <span
              class="rounded-full bg-secondary/20 px-3 py-1 text-xs font-medium text-secondary"
            >
              <i class="ri-leaf-line mr-1"></i>Dairy Free Options
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Footer -->
    <div
      class="flex flex-col items-center justify-center gap-3 border-t border-gray-700 pt-8 text-center lg:flex-row lg:justify-between"
    >
      <p class="text-sm text-gray-400">
        &copy; {new Date().getFullYear()} Get Yo Frozen Yogurt. All rights reserved.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/privacy-policy"
          class="text-sm text-gray-400 transition-colors hover:text-white hover:underline"
        >
          <i class="ri-shield-line mr-1"></i>Privacy Policy
        </a>
        <a
          href="/terms-of-service"
          class="text-sm text-gray-400 transition-colors hover:text-white hover:underline"
        >
          <i class="ri-file-text-line mr-1"></i>Terms of Service
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Responsive adjustments */
  @media (max-width: 640px) {
    .grid.lg\:grid-cols-2 > div {
      padding: 1.25rem !important;
    }
  }

  .hover\:transform:hover {
    transform: translateY(-4px);
    box-shadow:
      0 20px 25px -5px rgba(0, 0, 0, 0.3),
      0 10px 10px -5px rgba(0, 0, 0, 0.1);
  }

  /* Social Icon Styles */
  .social-icon {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #374151;
    color: #d1d5db;
    border-radius: 9999px;
    transition: all 0.2s;
  }

  .social-icon:hover {
    background-color: #f58220;
    color: white;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }
</style>
