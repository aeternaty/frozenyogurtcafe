      name="twitter:image"
      content="https://frozenyogurtcafe.com/assets/images/hero-background.webp"
    />

    <!-- Geo Meta Tags -->
    <meta name="geo.region" content="US-NJ" />
    <meta name="geo.placename" content="Marlboro, New Providence" />
    <meta name="geo.position" content="40.339677;-74.305915" />
