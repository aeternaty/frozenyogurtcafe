---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Get YO Frozen Yogurt Cafe serves fresh froyo with 16 main flavors & fresh toppings daily in Marlboro & New Providence NJ.",
