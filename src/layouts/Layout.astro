    <!-- Google Analytics + reCAPTCHA -->
    <!-- DO NOT DELETE: Google Analytics is temporarily paused. Uncomment to enable. -->
    <!-- <script async src="https://www.googletagmanager.com/gtag/js?id=G-D8M5Z9J4KL"></script> -->
  </head>
  <body id="home" class="bg-gray-50 font-sans text-gray-700 antialiased">
    <Header />
    <slot />
    <Footer />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      window.trackPhoneClick = function (location) {
        gtag("event", "phone_click", {
          event_category: "Contact",
          event_label: "Phone from GMB - " + location,
          value: 1,
        });
      };

      window.trackDirections = function (location) {
        gtag("event", "get_directions", {
          event_category: "GMB",
          event_label: "Directions - " + location,
          value: 1,
        });
      };

      window.onRecaptchaLoad = function () {
        setTimeout(function () {
          if (typeof window.initializeRecaptcha === "function") {
            window.initializeRecaptcha();
          }
        }, 500);
      };

      gtag("js", new Date());
      gtag("config", "G-D8M5Z9J4KL", {
        enhanced_conversions: true,
        custom_map: {
          custom_parameter_1: "gmb_source",
          custom_parameter_2: "location_id",
        },
      });

      var urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get("utm_source") === "gmb") {
        gtag("event", "gmb_website_click", {
          event_category: "GMB",
          event_label: urlParams.get("utm_campaign") || "unknown",
          value: 1,
        });
      }

      // 2. reCAPTCHA: ONLY load when user scrolls near a form (Best Practices 100 & Perf max)
      (function () {
        var rcLoaded = false;
        function loadRC() {
          if (rcLoaded) return;
          rcLoaded = true;
          var rc = document.createElement("script");
          rc.src =
            "https://www.google.com/recaptcha/api.js?onload=onRecaptchaLoad&render=explicit";
          rc.async = true;
          rc.defer = true;
          document.head.appendChild(rc);
        }

        if ("IntersectionObserver" in window) {
          var formObserver = new IntersectionObserver(
            function (entries, observer) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  loadRC();
                  observer.disconnect();
                }
              });
            },
            { rootMargin: "300px" },
          );

          window.addEventListener("DOMContentLoaded", function () {
            var forms = document.querySelectorAll("form");
            if (forms.length > 0) {
              forms.forEach(function (f) {
                formObserver.observe(f);
              });
            } else {
              setTimeout(loadRC, 10000); // fallback
            }
          });
        } else {
          setTimeout(loadRC, 8000); // fallback for old browsers
        }
      })();
    </script>

    <script src="/assets/js/main.js" is:inline></script>
    <script src="/assets/js/forms.js" is:inline></script>
    <script src="/assets/js/store-hours.js" is:inline></script>
    <script src="/assets/js/gmb-tracking.js" is:inline></script>
  </body>
</html>
