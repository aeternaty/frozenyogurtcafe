    <link rel="preload" as="style" href="/assets/css/remixicon.css" />
    <link id="css-icons" href="/assets/css/remixicon.css" rel="stylesheet" />
    <script is:inline>
      (function () {
        var el = document.getElementById("css-icons");
        if (el) {
          if (el.sheet) {
            el.media = "all";
          } else {
            el.onload = function () {
              this.media = "all";
            };
          }
        }
      })();
    </script>
    <noscript>
      <link
        rel="stylesheet"
