    <!-- OpenGraph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://frozenyogurtcafe.com/assets/images/hero-background.webp"
    />
    <meta property="og:url" content="https://frozenyogurtcafe.com" />
    <meta property="og:type" content="business.business" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://frozenyogurtcafe.com/assets/images/hero-background.webp"
    />

    <!-- Geo Meta Tags -->
    <meta name="geo.region" content="US-NJ" />
    <meta name="geo.placename" content="Marlboro, New Providence" />
    <meta name="geo.position" content="40.339677;-74.305915" />
    <meta name="ICBM" content="40.339677, -74.305915" />

    <meta name="theme-color" content="#F58220" />

    <!-- Favicons -->
    <link rel="icon" type="image/webp" href="/assets/images/favicon.webp" />
    <link rel="apple-touch-icon" href="/assets/images/favicon.webp" />
    <link rel="canonical" href="https://frozenyogurtcafe.com/" />

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <!-- Fonts & Icons: preload → stylesheet (onload via script, not attribute, avoids TS hints) -->
    <link
      id="css-fonts"
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Inter:wght@300;400;500;600;700&display=swap"
      as="style"
    />
    <link
      id="css-icons"
      rel="preload"
      href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"
      as="style"
    />
    <script is:inline>
      (function () {
        var ids = ["css-fonts", "css-icons"];
        ids.forEach(function (id) {
          var el = document.getElementById(id);
          if (el)
            el.onload = function () {
              this.rel = "stylesheet";
            };
        });
      })();
    </script>
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Pacifico&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
      />
      <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"
      />
    </noscript>

    <!-- Google Analytics -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-D8M5Z9J4KL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-D8M5Z9J4KL", {
        enhanced_conversions: true,
        custom_map: {
          custom_parameter_1: "gmb_source",
          custom_parameter_2: "location_id",
        },
      });

      function trackGMBClick(location) {
        gtag("event", "gmb_website_click", {
          event_category: "GMB",
          event_label: location,
          custom_parameter_1: "gmb",
          custom_parameter_2: location,
          value: 1,
        });
      }

      window.trackPhoneClick = function (location) {
        gtag("event", "phone_click", {
          event_category: "Contact",
          event_label: "Phone from GMB - " + location,
          value: 1,
        });
      };

      window.trackDirections = function (location) {
        gtag("event", "get_directions", {
          event_category: "GMB",
          event_label: "Directions - " + location,
          value: 1,
        });
      };

      document.addEventListener("DOMContentLoaded", function () {
        const urlParams = new URLSearchParams(window.location.search);
        const utmSource = urlParams.get("utm_source");
        const utmCampaign = urlParams.get("utm_campaign");

        if (utmSource === "gmb") {
          const location = utmCampaign || "unknown";
          trackGMBClick(location);
        }
      });
    </script>
  </head>
  <body id="home" class="bg-gray-50 font-sans text-gray-700 antialiased">
    <Header />
    <slot />
    <Footer />
    <!-- Global Scripts -->
    <script
      is:inline
      src="https://www.google.com/recaptcha/api.js?onload=onRecaptchaLoad&render=explicit"
      async
      defer></script>
    <script src="/assets/js/main.js" is:inline></script>
    <script src="/assets/js/forms.js" is:inline></script>
    <script src="/assets/js/store-hours.js" is:inline></script>
    <script src="/assets/js/gmb-tracking.js" is:inline></script>
    <!-- Vercel Analytics: injected automatically by Vercel in production -->
    <script is:inline>
      if (typeof window !== "undefined" && window.va) window.va("event", {});
    </script>
    <script is:inline>
      window.onRecaptchaLoad = function () {
        setTimeout(() => {
          if (typeof window.initializeRecaptcha === "function") {
            window.initializeRecaptcha();
          }
        }, 500);
      };
    </script>
  </body>
</html>
