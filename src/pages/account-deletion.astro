---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Account Deletion - Get Yo Frozen Yogurt"
  description="Delete your Get Yo account - Instructions and information"
>
  <div class="bg-gradient-to-br from-orange-50 via-white to-pink-50 py-12">
    <div class="container mx-auto max-w-2xl px-4">
      <div class="rounded-2xl bg-white p-6 shadow-xl md:p-8">
        <div class="mb-8">
          <a
            href="/"
            class="mb-6 inline-flex items-center text-primary transition-colors hover:text-orange-600"
          >
            <i class="ri-arrow-left-line mr-2"></i>
            Back to Home
          </a>
          <div class="text-center">
            <div
              class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-red-100"
            >
              <i class="ri-user-unfollow-line text-3xl text-red-600"></i>
            </div>
            <h1 class="mb-2 text-3xl font-bold text-gray-900 md:text-4xl">
              Delete Your Account
            </h1>
            <p class="text-gray-600">
              Remove your Get Yo account and personal data
            </p>
          </div>
        </div>

        <div class="space-y-6">
          <section>
            <h2 class="mb-4 flex items-center text-xl font-bold text-gray-900">
              <span
                class="mr-3 flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-bold text-white"
                >1</span
              >
              Delete Through the Mobile App
            </h2>

            <div
              class="mb-4 rounded-r-lg border-l-4 border-blue-500 bg-blue-50 p-4"
            >
              <p class="text-sm font-semibold text-blue-900">
                ✓ Easiest Method
              </p>
              <p class="mt-1 text-sm text-blue-800">
                The quickest way to delete your account
              </p>
            </div>

            <div class="ml-4 space-y-3">
              <div class="flex items-start space-x-3">
                <div
                  class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white"
                >
                  1
                </div>
                <div class="pt-1">
                  <p class="font-semibold text-gray-900">Open the Get Yo app</p>
                  <p class="text-sm text-gray-600">
                    Available on iOS and Android
                  </p>
                </div>
              </div>

              <div class="flex items-start space-x-3">
                <div
                  class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white"
                >
                  2
                </div>
                <div class="pt-1">
                  <p class="font-semibold text-gray-900">Go to your Profile</p>
                  <p class="text-sm text-gray-600">
                    Tap the profile icon at the bottom
                  </p>
                </div>
              </div>

              <div class="flex items-start space-x-3">
                <div
                  class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white"
                >
                  3
                </div>
                <div class="pt-1">
                  <p class="font-semibold text-gray-900">
                    Tap "Delete Account"
                  </p>
                  <p class="text-sm text-gray-600">
                    You'll find it at the bottom of settings
                  </p>
                </div>
              </div>

              <div class="flex items-start space-x-3">
                <div
                  class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-green-500 text-sm font-bold text-white"
                >
                  ✓
                </div>
                <div class="pt-1">
                  <p class="font-semibold text-gray-900">
                    Confirm you want to delete
                  </p>
                  <p class="text-sm text-gray-600">
                    We'll process your request within 30 days
                  </p>
                </div>
              </div>
            </div>
          </section>

          <section class="border-t pt-6">
            <h2 class="mb-4 flex items-center text-xl font-bold text-gray-900">
              <span
                class="mr-3 flex h-8 w-8 items-center justify-center rounded-full bg-orange-500 text-sm font-bold text-white"
                >2</span
              >
              Can't Access the App? Email Us
            </h2>
            <p class="mb-4 text-gray-700">
              If you can't get into the app, you can request deletion by email:
            </p>

            <div
              class="rounded-r-lg border-l-4 border-primary bg-orange-50 p-5"
            >
              <div class="mb-4">
                <p class="mb-2 font-semibold text-gray-800">
                  📧 Send an email to:
                </p>
                <a
                  href="mailto:privacy@getyocafe.com?subject=Account Deletion Request"
                  class="break-all text-lg font-bold text-primary underline hover:text-orange-600"
                >
                  privacy@getyocafe.com
                </a>
              </div>

              <div
                class="rounded-lg border border-orange-200 bg-white p-4 text-sm text-gray-700"
              >
                <p class="mb-2 font-semibold text-gray-900">
                  📝 What to include:
                </p>
                <ul class="ml-2 list-inside list-disc space-y-1">
                  <li>Subject line: "Account Deletion Request"</li>
                  <li>The email address you used for your account</li>
                  <li>Your full name</li>
                  <li>Optional: Why you're leaving (helps us improve)</li>
                </ul>
              </div>

              <div
                class="mt-4 rounded-lg border border-yellow-300 bg-yellow-100 p-3"
              >
                <p class="text-sm text-yellow-900">
                  <i class="ri-time-line mr-1"></i>
                  <strong>Timeline:</strong> We'll process your request within 7 business
                  days and send you a confirmation email.
                </p>
              </div>
            </div>
          </section>

          <section class="border-t pt-6">
            <h2 class="mb-4 flex items-center text-xl font-bold text-gray-900">
              <i class="ri-delete-bin-line mr-2 text-red-600"></i>
              What Gets Deleted from the App
            </h2>

            <div class="rounded-r-lg border-l-4 border-red-500 bg-red-50 p-5">
              <p class="mb-3 font-semibold text-red-900">
                When you delete your Get Yo account, we remove:
              </p>
              <ul class="space-y-2 text-sm text-red-900">
                <li class="flex items-start">
                  <i class="ri-close-circle-line mr-2 mt-0.5 flex-shrink-0"></i>
                  <span
                    ><strong>Your profile:</strong> Name, email, photo, phone number</span
                  >
                </li>
                <li class="flex items-start">
                  <i class="ri-close-circle-line mr-2 mt-0.5 flex-shrink-0"></i>
                  <span
                    ><strong>Your preferences:</strong> Favorite flavors, location
                    settings</span
                  >
                </li>
                <li class="flex items-start">
                  <i class="ri-close-circle-line mr-2 mt-0.5 flex-shrink-0"></i>
                  <span
                    ><strong>Your activity:</strong> Reviews, votes, flavor suggestions</span
                  >
                </li>
                <li class="flex items-start">
                  <i class="ri-close-circle-line mr-2 mt-0.5 flex-shrink-0"></i>
                  <span
                    ><strong>Everything else:</strong> All your personal data from
                    the app</span
                  >
                </li>
              </ul>
            </div>

            <div
              class="mt-4 rounded-r-lg border-l-4 border-yellow-500 bg-yellow-50 p-4"
            >
              <p class="text-sm text-yellow-900">
                <i class="ri-information-line mr-1 font-bold"></i>
                <strong>Note about reviews:</strong> Your past reviews might stay
                visible as "Former User" to keep community ratings fair, but they
                won't be connected to your identity anymore.
              </p>
            </div>
          </section>

          <section class="border-t pt-6">
            <h2 class="mb-4 flex items-center text-xl font-bold text-gray-900">
              <span
                class="mr-3 flex h-8 w-8 items-center justify-center rounded-full bg-purple-500 text-sm font-bold text-white"
                >!</span
              >
              Important: Rewards Program
            </h2>

            <div
              class="rounded-r-lg border-l-4 border-purple-500 bg-purple-50 p-5"
            >
              <p class="mb-3 font-bold text-purple-900">
                ⚠️ If you joined Ounce&Bounce rewards:
              </p>
              <p class="mb-4 text-sm text-purple-900">
                Deleting your Get Yo app account <strong>doesn't</strong> automatically
                delete your rewards account. That's managed separately by RewardUp.io,
                so you'll need to delete it there too.
              </p>

              <div
                class="mb-4 rounded-lg border border-purple-300 bg-white p-4"
              >
                <p class="mb-2 font-semibold text-purple-900">
                  How to delete your rewards account:
                </p>
                <ol
                  class="ml-2 list-inside list-decimal space-y-2 text-sm text-purple-900"
                >
                  <li>
                    Go to <a
                      href="https://get-yo.member.rewardup.io"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-semibold text-primary underline hover:text-orange-600"
                      >get-yo.member.rewardup.io</a
                    >
                  </li>
                  <li>Log into your rewards account</li>
                  <li>Find account settings</li>
                  <li>Request deletion through their system</li>
                </ol>
              </div>

              <div
                class="rounded-lg border border-orange-300 bg-orange-100 p-3"
              >
                <p class="text-sm font-semibold text-orange-900">
                  <i class="ri-alert-line mr-1"></i>
                  Or just email <a
                    href="mailto:support@rewardup.io"
                    class="underline">support@rewardup.io</a
                  > and ask them to delete your Ounce&Bounce rewards account.
                </p>
              </div>
            </div>
          </section>

          <section class="border-t pt-6">
            <h2 class="mb-4 flex items-center text-xl font-bold text-gray-900">
              <i class="ri-time-line mr-2 text-blue-600"></i>
              How Long It Takes
            </h2>

            <div class="space-y-3">
              <div class="flex items-start space-x-3">
                <div
                  class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-blue-100"
                >
                  <i class="ri-calendar-line text-blue-600"></i>
                </div>
                <div>
                  <p class="font-semibold text-gray-900">Right Away</p>
                  <p class="text-sm text-gray-600">
                    Your account is deactivated - you can't log in anymore
                  </p>
                </div>
              </div>

              <div class="flex items-start space-x-3">
                <div
                  class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-blue-100"
                >
                  <i class="ri-database-line text-blue-600"></i>
                </div>
                <div>
                  <p class="font-semibold text-gray-900">Within a Week</p>
                  <p class="text-sm text-gray-600">
                    Your main data is deleted from our active systems
                  </p>
                </div>
              </div>

              <div class="flex items-start space-x-3">
                <div
                  class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-blue-100"
                >
                  <i class="ri-check-line text-blue-600"></i>
                </div>
                <div>
                  <p class="font-semibold text-gray-900">Within 30 Days</p>
                  <p class="text-sm text-gray-600">
                    All backups are cleared - everything's gone
                  </p>
                </div>
              </div>
            </div>
          </section>

          <section class="border-t pt-6">
            <div class="rounded-r-lg border-l-4 border-red-600 bg-red-50 p-5">
              <div class="flex items-start">
                <i
                  class="ri-alert-line mr-3 mt-0.5 flex-shrink-0 text-2xl text-red-600"
                ></i>
                <div>
                  <p class="mb-2 text-lg font-bold text-red-900">
                    ⚠️ This Can't Be Undone
                  </p>
                  <p class="mb-3 text-sm text-red-800">
                    Once your Get Yo account is deleted, it's gone forever. All
                    your preferences, favorites, and history will be permanently
                    lost.
                  </p>
                  <p class="text-sm text-red-800">
                    <strong>Remember:</strong> If you joined Ounce&Bounce rewards,
                    you need to separately delete that account from RewardUp.io (see
                    above).
                  </p>
                  <p class="mt-2 text-sm text-red-800">
                    If you want to use Get Yo again later, you'll have to start
                    fresh with a new account.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <section class="border-t pt-6">
            <h2 class="mb-4 flex items-center text-xl font-bold text-gray-900">
              <i class="ri-question-line mr-2 text-primary"></i>
              Need Help?
            </h2>
            <div class="rounded-lg border border-gray-200 bg-gray-50 p-5">
              <p class="mb-3 text-gray-800">
                Questions about deleting your account?
              </p>

              <div class="space-y-2 text-gray-700">
                <p class="flex items-center">
                  <i class="ri-mail-line mr-2 text-primary"></i>
                  <strong>Email:</strong>
                  <a
                    href="mailto:privacy@getyocafe.com"
                    class="ml-2 text-primary underline hover:text-orange-600"
                  >
                    privacy@getyocafe.com
                  </a>
                </p>
                <p class="flex items-center">
                  <i class="ri-phone-line mr-2 text-primary"></i>
                  <strong>Call:</strong>
                  <span class="ml-2">(732) 617-6332 or (908) 219-4338</span>
                </p>
                <p class="flex items-center">
                  <i class="ri-file-list-line mr-2 text-primary"></i>
                  <strong>Read:</strong>
                  <a
                    href="/privacy-policy"
                    class="ml-2 text-primary underline hover:text-orange-600"
                  >
                    Our Privacy Policy
                  </a>
                </p>
              </div>
            </div>
          </section>

          <section class="border-t pt-6">
            <div class="rounded-lg border border-blue-200 bg-blue-50 p-5">
              <h3
                class="mb-2 flex items-center text-lg font-bold text-blue-900"
              >
                <i class="ri-lightbulb-line mr-2"></i>
                Before You Go...
              </h3>
              <p class="mb-3 text-sm text-blue-800">
                Have you considered these alternatives?
              </p>
              <ul
                class="ml-4 list-inside list-disc space-y-1 text-sm text-blue-800"
              >
                <li>Turn off push notifications instead</li>
                <li>Adjust your privacy settings in the app</li>
                <li>Contact us if something's not working right</li>
                <li>
                  Just take a break - your account will be here when you're
                  ready to come back
                </li>
              </ul>
            </div>
          </section>
        </div>

        <div class="mt-8 border-t pt-6 text-center">
          <p class="text-sm text-gray-600">
            <a
              href="/privacy-policy"
              class="text-primary underline hover:text-orange-600"
              >Privacy Policy</a
            >
            <span class="mx-2">•</span>
            <a
              href="/terms-of-service"
              class="text-primary underline hover:text-orange-600"
              >Terms of Service</a
            >
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
