---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found - Frozen Yogurt Cafe | Get Yo"
  description="Page not found. Visit our frozen yogurt cafe locations in Marlboro & New Providence, NJ for delicious treats!"
>
  <div
    class="flex min-h-[70vh] items-center justify-center bg-gradient-to-br from-primary/5 to-secondary/5 py-20"
  >
    <div class="mx-auto max-w-lg px-4 text-center">
      <div class="mb-8">
        <div class="mb-4 text-8xl font-bold text-primary">404</div>
        <h1 class="mb-4 text-3xl font-bold text-gray-800">
          Sweet! You found our secret page!
        </h1>
        <p class="mb-8 text-lg text-gray-600">
          Just kidding... This page doesn't exist, but our delicious frozen
          yogurt does! Let's get you back to the good stuff.
        </p>
      </div>

      <div class="mb-6 rounded-lg bg-white p-6 shadow-lg">
        <h2 class="mb-4 text-xl font-bold text-gray-800">Try these instead:</h2>
        <div class="space-y-3">
          <a
            href="/"
            class="block rounded-lg bg-primary px-6 py-3 font-medium text-white transition-colors hover:bg-opacity-90"
          >
            🏠 Go Home
          </a>
          <a
            href="/#menu"
            class="block rounded-lg border-2 border-primary bg-white px-6 py-3 font-medium text-primary transition-colors hover:bg-primary hover:text-white"
          >
            🍨 View Our Flavors
          </a>
          <a
            href="/#locations"
            class="block rounded-lg border-2 border-secondary bg-white px-6 py-3 font-medium text-secondary transition-colors hover:bg-secondary hover:text-white"
          >
            📍 Find Our Locations
          </a>
        </div>
      </div>

      <div class="text-sm text-gray-500">
        <p>Visit us at:</p>
        <p>
          <strong>Marlboro:</strong> 450 Union Hill Road, Morganville, NJ | (732)
          617-6332
        </p>
        <p>
          <strong>New Providence:</strong> 12 South Street, New Providence, NJ | (908)
          219-4338
        </p>
      </div>
    </div>
  </div>
</Layout>
