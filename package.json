{
  "name": "frozenyogurtcafe",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && prettier --check \"**/*.{astro,tsx,ts,md,json,css,mjs}\"",
    "fix": "prettier --write \"**/*.{astro,tsx,ts,md,json,css,mjs}\" && astro check",
    "lighthouse": "unlighthouse --site http://localhost:4321",
    "lighthouse:ci": "unlighthouse-ci --site http://localhost:4321",
    "lighthouse:live": "unlighthouse --site https://frozenyogurtcafe.com",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@vercel/analytics": "^2.0.0",
    "astro": "^5.18.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@astrojs/sitemap": "^3.7.1",
    "@astrojs/vercel": "^8.0.4",
    "@unlighthouse/cli": "^0.17.7",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^1.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
